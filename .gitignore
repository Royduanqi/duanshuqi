# ===== Obsidian 工作区与缓存（不纳入版本管理）=====
.obsidian/workspace.json
.obsidian/workspace-mobile.json
.obsidian/cache
.obsidian/plugins/*/workspace.json
.trash/

# 保留 .obsidian 里的插件、主题与核心配置：
# .obsidian/app.json
# .obsidian/appearance.json
# .obsidian/core-plugins.json
# .obsidian/plugins/**(除上面的 workspace.json)
# .obsidian/themes/**
# .obsidian/snippets/**

# ===== 操作系统临时文件 =====
.DS_Store
Thumbs.db
desktop.ini

# ===== 临时文件 =====
*.tmp
*.temp
*.bak
~$*
